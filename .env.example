MYSQL_DATABASE=donga_rag
MYSQL_USER=donga
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_HOST=db
MYSQL_PORT=3306
# Set a long random token; required for crawl, ingest and debug endpoints.
ADMIN_API_KEY=
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_MODEL=gpt-4.1-mini
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=35
CHROMA_HOST=vector-db
CHROMA_PORT=8000
CHROMA_COLLECTION=donga_rag_collection
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_REVISION=bf3bf13ab40c3157080a7ab344c831b9ad18b5eb
EMBEDDING_BATCH_SIZE=8
N_RESULTS=5
# Cosine distance: lower is closer. Tune with a held-out question set.
MAX_DISTANCE=0.65
CRAWL_PAGES=1
CRAWL_MAX_NOTICES=10
CRAWL_DELAY_SECONDS=1
CRAWLER_USER_AGENT=DongaRAGStudentProject/2.0
# Opt-in only; public MVP does not save user questions by default.
SAVE_CHAT_HISTORY=false

# Personal Canvas CLI only. Set the exact HTTPS origin shown in Canvas settings.
# Never place this token in chat, HTML, or the shared document database.
CANVAS_BASE_URL=
CANVAS_API_TOKEN=

# Owner-only localhost demo; dedicated password must be at least 16 characters.
CANVAS_PERSONAL_DEMO_ENABLED=false
CANVAS_DEMO_PASSWORD=

# OAuth multi-user service. Personal CANVAS_API_TOKEN is NEVER used by OAuth routes.
CANVAS_OAUTH_ENABLED=false
APP_PUBLIC_ORIGIN=
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
# Generate locally: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CANVAS_TOKEN_ENCRYPTION_KEY=
